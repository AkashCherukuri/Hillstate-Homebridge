{
  "pluginAlias": "Hillstate IOT",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": false,
  "schema": {
    "type": "object",
    "required": [
      "username",
      "password",
      "dong",
      "ho"
    ],
    "additionalProperties": false,
    "properties": {
      "username": {
        "title": "Hillstate IOT username",
        "type": "string",
        "default": "Enter your username"
      },
      "password": {
        "title": "Hillstate IOT password",
        "type": "string",
        "x_schema-form": {
          "type": "password"
        }
      },
      "dong": {
        "title": "Hillstate Dong number",
        "type": "number",
        "default": 101
      },
      "ho": {
        "title": "Hillstate Ho number",
        "type": "number"
      },
      "bathroomVentName": {
        "title": "Bathroom Vent name on Hillstate",
        "type": "string",
        "default": "\uc8fc\ubc291-4"
      },
      "deviceNames": {
        "title": "Device names",
        "description": "HomeKit names for each Hillstate device ID. These are the fallback if a Home app rename is ever lost, so fill them in.",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "title": "Device ID",
              "type": "string",
              "required": true
            },
            "name": {
              "title": "HomeKit name",
              "type": "string",
              "required": true
            }
          }
        }
      }
    }
  }
}
