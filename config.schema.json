{
  "pluginAlias": "Hillstate IOT",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": false,
  "schema": {
    "type": "object",
    "required": [
      "username",
      "password",
      "dong",
      "ho"
    ],
    "additionalProperties": false,
    "properties": {
      "username": {
        "title": "Hillstate IOT username",
        "type": "string",
        "default": "Enter your username"
      },
      "password": {
        "title": "Hillstate IOT password",
        "type": "string",
        "x_schema-form": {
          "type": "password"
        }
      },
      "dong": {
        "title": "Hillstate Dong number",
        "type": "number",
        "default": 101
      },
      "ho": {
        "title": "Hillstate Ho number",
        "type": "number"
      },
      "bathroomVentName": {
        "title": "Bathroom Vent name on Hillstate",
        "type": "string",
        "default": "주방1-4"
      }
    }
  }
}
